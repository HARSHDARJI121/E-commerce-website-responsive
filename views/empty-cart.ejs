<!-- views/empty-cart.ejs -->
<!DOCTYPE html>
<html lang="en">
    <style>
        /* General Styling */
body {
  font-family: 'Arial', sans-serif;
  background-color: #f8f9fa;
  color: #333;
  text-align: center;
  padding: 50px 20px;
}

h1 {
  font-size: 2.5rem;
  color: #d9534f;
  margin-bottom: 20px;
}

p {
  font-size: 1.2rem;
  color: #777;
  margin-bottom: 30px;
}

a {
  font-size: 1.2rem;
  color: #007bff;
  text-decoration: none;
  padding: 10px 20px;
  border: 2px solid #007bff;
  border-radius: 25px;
  transition: all 0.3s ease;
}

a:hover {
  background-color: #007bff;
  color: white;
  border-color: #0056b3;
}

@media (max-width: 768px) {
  h1 {
    font-size: 2rem;
  }

  p {
    font-size: 1rem;
  }

  a {
    font-size: 1rem;
    padding: 8px 16px;
  }
}

    </style>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Empty Cart</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <h1>Your cart is empty!</h1>
  <p>It looks like you haven't added anything to your cart yet.</p>
  <a href="/">Go back to shopping</a>
</body>
</html>
