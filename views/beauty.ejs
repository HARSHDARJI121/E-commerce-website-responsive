<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        /* Basic Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* Sticky Nav Styling */
        nav {
    position: sticky;
    background-color: #ffffff;
    top: 0;
    height: 70px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
    box-shadow: rgba(0, 0, 0, 0.1) 0px 3px 6px;
    width: 100%;
    z-index: 100;
}

/* Hamburger Menu */
.menu-toggle {
    display: none;
}

/* Left Section (Logo and Links) */
.left {
    display: flex;
    align-items: center;
}

.left img {
    width: 53px;
    height: 36px;
    margin-right: 20px;
}

.left ul {
    display: flex;
    list-style: none;
    gap: 20px;
}

.left a {
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 1px;
    color: #333;
    padding: 0 10px;
    transition: color 0.3s ease;
}

.left a:hover {
    color: #ff5722;
}

/* Right Section (Search, Cart, Profile Icons) */
.right {
    display: flex;
    align-items: center;
    gap: 20px;
}

.right input {
    font-size: 14px;
    height: 36px;
    width: 250px;
    padding: 8px 15px;
    border: 1px solid #ccc;
    border-radius: 4px;
    background: #f9f9f9;
    color: #696e79;
    outline: none;
    transition: width 0.3s ease;
}

.right input:focus {
    width: 300px;
    border-color: #ff5722;
}

.icons {
    display: flex;
    gap: 20px;
    margin-right: 20px;
}

.icons a {
    text-decoration: none;
    color: #333;
    font-size: 16px;
    padding: 5px;
    transition: color 0.3s ease;
}

.icons a:hover {
    color: #ff5722;
}

/* Mobile Responsive */
@media (max-width: 768px) {
    nav {
        padding: 0 10px; /* Reduce padding for smaller screens */
    }

    .left ul {
        display: none; /* Hide links on smaller screens */
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        background-color: #fff;
        box-shadow: rgba(0, 0, 0, 0.1) 0px 3px 6px;
        flex-direction: column;
        padding: 10px;
        text-align: center;
    }

    .left ul li {
        margin: 10px 0;
    }

    .left a {
        font-size: 16px; /* Increase font size on mobile */
    }

    /* Toggle Menu Button (Hamburger) */
    .menu-toggle {
        display: block;
        font-size: 24px;
        cursor: pointer;
        color: #333;
    }

    /* Mobile navigation - display links when menu is active */
    .left.active ul {
        display: flex;
    }

    .right {
        display: flex; /* Show right section on mobile */
        gap: 15px;
    }

    .right input {
        display: none; /* Hide search input on mobile */
    }

    .icons a {
        font-size: 18px; /* Increase icon size */
    }
    .section{
        width: 100%;
        margin: auto;
    }
}

/* Tablet & Small Device Adjustments */
@media (max-width: 500px) {
    .right input {
        width: 150px;
        font-size: 12px;
    }

    .icons a {
        font-size: 14px;
    }

    .right {
        gap: 15px;
    }

    .menu-toggle {
        font-size: 22px;
    }
}

/* Add Cart and Profile Icons */
.icons a.cart, .icons a.profile {
    font-size: 20px;
    cursor: pointer;
    transition: transform 0.3s ease;
}

.icons a.cart:hover, .icons a.profile:hover {
    transform: scale(1.1);
}

/* General Styles */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Clothes Section */
.clothes {
    padding: 20px;
    background-color: #f9f9f9;
}

/* Container */
.container {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    margin: 0 auto;
    max-width: 1200px;
    padding: 10px;
}

/* Cards */
.cards {
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
    cursor: pointer;
}

.cards:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
}

/* Card Image */
.cards img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

/* Card Content */
.cards h3 {
    font-size: 1.2rem;
    margin: 10px;
    color: #333;
}

.cards h4 {
    font-size: 1rem;
    margin: 0 10px 10px;
    color: #666;
}

.cards h1 {
    font-size: 1.5rem;
    margin: 10px;
    color: #e63946;
}

/* Responsive Design */
@media (max-width: 768px) {
    .container {
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }

    .cards h3 {
        font-size: 1rem;
    }

    .cards h4 {
        font-size: 0.9rem;
    }

    .cards h1 {
        font-size: 1.2rem;
    }
}

@media (max-width: 480px) {
    .cards img {
        height: 150px;
        object-fit: cover;
    }

    .cards h3, .cards h4, .cards h1 {
        margin: 5px;
    }
}

    </style>
</head>

<body>
    <nav>
        <div class="left">
            <img src="https://raw.githubusercontent.com/ZeroOctave/ZeroOctave-Javascript-Projects/main/assets/Images/myntraclone/logo.png" alt="">
            <ul>
                <li><a href="/menclothes">MEN</a></li>
                <li><a href="/womenclothes">WOMEN</a></li>
                <li><a href="/menaccessories">MEN ACCESSORIES</a></li>
                <li><a href="/womenaccessories">WOMEN ACCESSORIES</a></li>
                <li><a href="/beauty">BEAUTY</a></li>

            </ul>
        </div>
        <div class="right">
            <input class="search" type="text" placeholder="Search...">
            <div class="icons">
                <a href="/cart">CART</a>
                <a href="/profile">PROFILE</a>
            </div>
        </div>
        <!-- Hamburger Icon for mobile -->
        <span class="menu-toggle">&#9776;</span>
    </nav>
    

    <div class="clothes">
        <div class="container"></div>
    </div>

    <script>
        const menuToggle = document.querySelector('.menu-toggle');
        const navLeft = document.querySelector('.left');

        menuToggle.addEventListener('click', () => {
            navLeft.classList.toggle('active');
        });

        fetch('/api/products?category=beauty')
  .then(response => {
    console.log('Response status:', response.status);  // Log the response status
    return response.json();
  })
  .then(products => {
    console.log('Fetched products:', products);  // Log the fetched products
    const container = document.querySelector('.container');
    container.innerHTML = ''; // Clear existing content

    if (products.error) {
      container.innerHTML = `<p>${products.error}</p>`; // Show error message if no products found
      return;
    }

    products.forEach(product => {
      const card = document.createElement('div');
      card.classList.add('cards');
      card.addEventListener('click', () => {
        window.location.href = `/product-details/${product._id}`; // Use MongoDB `_id` field
      });

      const img = document.createElement('img');
      img.src = product.image;
      img.alt = product.name;
      card.appendChild(img);

      const h3 = document.createElement('h3');
      h3.textContent = product.name || 'No name available';
      card.appendChild(h3);

      const h4 = document.createElement('h4');
      h4.textContent = product.short_description || 'No description available';
      card.appendChild(h4);

      const h1 = document.createElement('h1');
      const price = product.retail_price ?? 1000;
      h1.textContent = `₹${price}`;
      card.appendChild(h1);

      container.appendChild(card);
    });
  })
  .catch(error => {
    console.error('Error fetching products:', error);
  });

    </script>
</body>

</html>
