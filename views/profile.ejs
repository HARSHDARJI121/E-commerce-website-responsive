<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f9f9f9;
        }

        /* Navbar Styling */
        nav {
            position: sticky;
            background-color: #ffffff;
            top: 0;
            height: 70px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            box-shadow: rgba(0, 0, 0, 0.1) 0px 3px 6px;
            width: 100%;
            z-index: 100;
        }

        /* Left Section (Logo and Links) */
        .left {
            display: flex;
            align-items: center;
        }

        .left img {
            width: 53px;
            height: 36px;
            margin-right: 20px;
        }

        .left ul {
            display: flex;
            list-style: none;
            gap: 20px;
        }

        .left a {
            text-decoration: none;
            text-transform: uppercase;
            font-weight: 500;
            font-size: 14px;
            letter-spacing: 1px;
            color: #333;
            padding: 0 10px;
            transition: color 0.3s ease;
        }

        .left a:hover {
            color: #ff5722;
        }

        /* Right Section (Search and Icons) */
        .right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .right input {
            font-size: 14px;
            height: 36px;
            width: 250px;
            padding: 8px 15px;
            border: 1px solid #ccc;
            border-radius: 4px;
            background: #f9f9f9;
            color: #696e79;
            outline: none;
            transition: width 0.3s ease;
        }

        .right input:focus {
            width: 300px;
            border-color: #ff5722;
        }

        /* Icons Section */
        .icons {
            display: flex;
            gap: 20px;
        }

        .icons a {
            text-decoration: none;
            color: #333;
            font-size: 16px;
            padding: 5px;
            transition: color 0.3s ease;
        }

        .icons a:hover {
            color: #ff5722;
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            .left ul {
                display: none;
            }

            .right input {
                width: 150px;
            }

            .icons a {
                font-size: 14px;
            }
        }

        /* Profile Section */
        .profile-container {
            max-width: 1200px;
            margin: 20px auto;
            background: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 6px;
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
        }

        .profile-photo {
            flex: 1 1 30%;
            text-align: center;
        }

        .profile-photo img {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #e91e63;
        }

        .profile-info {
            flex: 1 1 60%;
        }

        .profile-info h2 {
            font-size: 24px;
            color: #333;
            margin-bottom: 10px;
        }

        .profile-info p {
            font-size: 16px;
            color: #666;
            margin-bottom: 8px;
        }

        .profile-info .highlight {
            font-weight: bold;
            color: #333;
        }

        /* Features Section */
        .features {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 20px;
        }

        .feature-card {
            flex: 1 1 30%;
            background: #f5f5f5;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: rgba(0, 0, 0, 0.1) 0px 8px 16px;
        }

        .feature-card i {
            font-size: 40px;
            color: #e91e63;
            margin-bottom: 10px;
        }

        .feature-card h3 {
            font-size: 18px;
            color: #333;
            margin-bottom: 10px;
        }

        .feature-card p {
            font-size: 14px;
            color: #666;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav>
        <div class="left">
            <img src="https://raw.githubusercontent.com/ZeroOctave/ZeroOctave-Javascript-Projects/main/assets/Images/myntraclone/logo.png" alt="">
            <ul>
                <a href="/menclothes">Men</a>
                <a href="/womenclothes">Women</a>
                <a href="/menaccessories">Men Accessories</a>
                <a href="/beauty">Beauty</a>
                <a href="/womenaccessories">Women Accessories</a>
            </ul>
        </div>
        <div class="right">
            <input placeholder="Search for products, brands and more" class="desktop-searchBar">
            <div class="icons">
                <a href="/profile">Profile</a>
                <a href="/cart">Cart</a>
            </div>
        </div>
    </nav>

    <!-- Profile Section -->
    <div class="profile-container">
        <div class="profile-photo">
            <img src="https://tse1.mm.bing.net/th?id=OIP.DCwFdwpjtPKkbeJdVl3Q5AHaJQ&pid=Api&P=0&h=180" alt="User Photo">
        </div>
        <div class="profile-info">
            <h2>John Doe</h2>
            <p><span class="highlight">Email:</span> johndoe@example.com</p>
            <p><span class="highlight">Address:</span> 123 Street Name, City, State</p>
            <p><span class="highlight">Pincode:</span> 123456</p>
        </div>
    </div>

    <!-- Features Section -->
    <div class="features">
        <div class="feature-card">
            <i class="fas fa-box"></i>
            <h3>My Orders</h3>
            <p>Track and manage your orders.</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-heart"></i>
            <h3>Wishlist</h3>
            <p>View and manage your wishlist.</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-gift"></i>
            <h3>Gift Cards</h3>
            <p>Manage your gift cards.</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-map-marker-alt"></i>
            <h3>Saved Addresses</h3>
            <p>Update and manage your addresses.</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-credit-card"></i>
            <h3>Payment Options</h3>
            <p>Manage your saved payment methods.</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-cog"></i>
            <h3>Account Settings</h3>
            <p>Update your account details.</p>
        </div>
    </div>
</body>
</html>
