}


/* Footer Styling */
footer {
    height: 55px;
    background-color: #f7f7f7;
    padding-top: 28px;
    font-size: 14px;
    color: #696b79;
    font-family: Whitney, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    letter-spacing: .3px;
}

footer a {
    cursor: pointer;
    color: #696b79;
    text-decoration: none;
    font-weight: 500;
}


/* Section grid adjustments */
.box {
    display: flex;
    justify-content: space-between;
    gap: 50px;
    text-align: center;
    flex-wrap: wrap;
    margin-top: 40px;
}

.box img {
    height: 300px;
    width: 250px;
    border-radius: 20px;
    transition: transform 0.3s ease;
}

.box img:hover {
    transform: scale(1.05);
}

.cards {
    height: 300px;
    width: 200px;
    margin: auto;
}

.cards:hover {
    border-radius: 20px;
    box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
    background-color: antiquewhite;
    color: rgb(0, 0, 0);
}

.cards h3:hover {
    color: black;
}

.text {
    box-sizing: border-box;
    text-align: center;
    padding: 10px;
    margin-bottom: 10px;
}

/* Section 3 flex adjustment */
/* Container for the sections */
.sec-3 {
    display: flex;
    flex-direction: column;
    align-items: center;

    margin-bottom: 20px;
}

.box {
    display: grid;
    grid-template-columns: repeat(4, 1fr); /* 4 equal columns */
    gap: 20px;
    width: 100%;
    margin: 0 auto;
}

/* Styling for each product card */
.cards {

    object-fit: cover;
    justify-content: space-between;
    background-color: #fff;
    border: 1px solid #ddd;
    padding: 20px;
    text-align: center;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.cards img {
    height: 200px;
    border-radius: 8px;
    margin-bottom: 15px;
}

/* Title and Price styling */
.cards h3 {
    font-size: 1.2rem;
    font-weight: bold;
    margin: 10px 0;
}

.cards h4 {
    font-size: 1rem;
    color: #555;
    margin: 5px 0;
}

.cards h1 {
    font-size: 1.4rem;
    color: #f44336;
    margin: 10px 0;
}

/* Hover effects */
.cards:hover {
    transform: translateY(-10px);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
}

.cards:hover img {
    transform: scale(1.05);
    transition: transform 0.3s ease;
}

/* Styling for the section title */
.text h1 {
    font-size: 2rem;
    text-align: center;
    margin: 20px 0;
    color: #333;
}



/* Container for product cards */
.box {
    display: grid;
    justify-content: space-around;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); /* Responsive grid */
    gap: 20px;
}

/* Styling for individual product cards */
.cards {
    background-color: #fff;
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    padding: 10px;
    height: 450px;
    margin-left: 100px;
    transition: transform 0.3s ease;
}

/* Image inside each card */
.cards img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    transition: transform 0.3s ease;
}

/* Card hover effect */
.cards:hover {
    transform: scale(1.05);
}

/* Heading and pricing inside cards */
.cards h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 10px 0;
}

.cards h4 {
    font-size: 14px;
    color: #777;
    margin: 5px 0;
}

.cards h1 {
    font-size: 20px;
    color: #333;
    font-weight: 600;
    margin: 10px 0;
}


/* Mobile and tablet responsiveness */
@media (max-width: 1024px) {
    .box {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); /* Slightly larger columns for tablets */
    }

    .cards h3 {
        font-size: 16px;
    }

    .cards h4 {
        font-size: 12px;
    }

    .cards h1 {
        font-size: 18px;
    }
}

@media (max-width: 768px) {
    .box {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); /* Adjust for smaller screens */
    }

    .cards h3 {
        font-size: 14px;
    }

    .cards h4 {
        font-size: 10px;
    }

    .cards h1 {
        font-size: 16px;
    }
}

@media (max-width: 480px) {
    .box {
        grid-template-columns: 1fr; /* Single column on very small screens */
    }

    .cards h3 {
        font-size: 14px;
    }

    .cards h4 {
        font-size: 10px;
    }

    .cards h1 {
        font-size: 16px;
    }

    /* Optional: Make text more readable on very small screens */
    .text h1 {
        font-size: 20px;
        text-align: center;
    }
    .cards{
        margin: auto;
    }
}

/* Mobile responsive for footer section */
.foot {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    background-color: black;
    color: aliceblue;
    height: 300px;
