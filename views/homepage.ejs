   <style>
    * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}
html, body {
    overflow-y: scroll; /* Enable scrolling */
    scrollbar-width: thin; /* Optional: make the scrollbar thinner (for Firefox) */
    scrollbar-color: transparent transparent; /* Optional: hide the scrollbar (for Firefox) */
}

/* For Webkit browsers (Chrome, Safari) */
body::-webkit-scrollbar {
    width: 0px;
    background: transparent;
}

body::-webkit-scrollbar-thumb {
    background: transparent;
}


body {
    overflow-x: hidden; /* Prevent horizontal scrolling */
    font-family: 'Arial', sans-serif;
}

/* Sticky Nav Styling */
nav {
    position: sticky;
    background-color: #ffffff;
    top: 0;
    height: 70px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
    box-shadow: rgba(0, 0, 0, 0.1) 0px 3px 6px;
    width: 100%;
    z-index: 100;
}

/* Hamburger Menu */
.menu-toggle {
    display: none;
}

/* Left Section (Logo and Links) */
.left {
    display: flex;
    align-items: center;
}

.left img {
    width: 53px;
    height: 36px;
    margin-right: 20px;
}

.left ul {
    display: flex;
    list-style: none;
    gap: 20px;
}

.left a {
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 1px;
    color: #333;
    padding: 0 10px;
    transition: color 0.3s ease;
}

.left a:hover {
    color: #ff5722;
}

/* Right Section (Search, Cart, Profile Icons) */
.right {
    display: flex;
    align-items: center;
    gap: 20px;
}

.right input {
    font-size: 14px;
    height: 36px;
    width: 250px;
    padding: 8px 15px;
    border: 1px solid #ccc;
    border-radius: 4px;
    background: #f9f9f9;
    color: #696e79;
    outline: none;
    transition: width 0.3s ease;
}

.right input:focus {
    width: 300px;
    border-color: #ff5722;
}

.icons {
    display: flex;
    gap: 20px;
    margin-right: 20px;
}

.icons a {
    text-decoration: none;
    color: #333;
    font-size: 16px;
    padding: 5px;
    transition: color 0.3s ease;
}

.icons a:hover {
    color: #ff5722;
}

/* Mobile Responsive */
@media (max-width: 768px) {
    nav {
        padding: 0 10px; /* Reduce padding for smaller screens */
    }

    .left ul {
        display: none; /* Hide links on smaller screens */
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        background-color: #fff;
        box-shadow: rgba(0, 0, 0, 0.1) 0px 3px 6px;
        flex-direction: column;
        padding: 10px;
        text-align: center;
    }

    .left ul li {
        margin: 10px 0;
    }

    .left a {
        font-size: 16px; /* Increase font size on mobile */
    }

    /* Toggle Menu Button (Hamburger) */
    .menu-toggle {
        display: block;
        font-size: 24px;
        cursor: pointer;
        color: #333;
    }

    /* Mobile navigation - display links when menu is active */
    .left.active ul {
        display: flex;
    }

    .right {
        display: flex; /* Show right section on mobile */
        gap: 15px;
    }

    .right input {
        display: none; /* Hide search input on mobile */
    }

    .icons a {
        font-size: 18px; /* Increase icon size */
    }
    .section{
        width: 100%;
        margin: auto;
    }
}

/* Tablet & Small Device Adjustments */
@media (max-width: 500px) {
    .right input {
        width: 150px;
        font-size: 12px;
    }

    .icons a {
        font-size: 14px;
    }

    .right {
        gap: 15px;
    }

    .menu-toggle {
        font-size: 22px;
    }
}

/* Add Cart and Profile Icons */
.icons a.cart, .icons a.profile {
    font-size: 20px;
    cursor: pointer;
    transition: transform 0.3s ease;
}

.icons a.cart:hover, .icons a.profile:hover {
    transform: scale(1.1);
}
/* Marquee Container */
.marquee-container {
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
    height: 100%;
    background-color: #fff;
    border: 1px solid #ddd;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    margin: 20px 0;
}

/* Marquee Content (Scrolling images) */
.marquee {
    display: inline-flex;
    animation: scroll 20s linear infinite;
    height: 250px;
}

.marquee img {
    width: 150px;  /* Default image width */
    height: 250px; /* Default image height */
    margin: 0 10px;
    border-radius: 5px;
    border: 1px solid #ccc;
    transition: transform 0.3s ease-in-out;
    object-fit: cover;
}

.marquee img:hover {
    transform: scale(1.1); /* Hover effect to enlarge image */
}

/* Keyframe for scrolling */
@keyframes scroll {
    0% {
        transform: translateX(100%);
    }
    100% {
        transform: translateX(-100%);
    }
}

/* Mobile (max-width: 768px) */
@media (max-width: 768px) {
    .marquee img {
        width: 180px;  /* Adjust image width for mobile */
        height: 100px; /* Adjust image height for mobile */
    }

    .marquee-container {
        margin: 10px 0; /* Reduce container margin on mobile */
    }
}

/* Tablet (max-width: 500px) */
@media (max-width: 500px) {
    .marquee img {
        margin-top: 20px;
        width: 150px;  /* Adjust image width for smaller tablet screens */
        height: 190px; /* Adjust image height for smaller tablet screens */
    }

    .marquee-container {
        margin-top: 20px;
        margin: 5px 0; /* Further reduce margin for small tablets */
    }
}



/* Section Layout Adjustments */
.container img {
    cursor: pointer;
    width: 100%;
    background-repeat: no-repeat;
    background-size: cover;
    margin-bottom: 25px;
}

.section {
    display: flex;
    justify-content: center;
}

.section img {
    cursor: pointer;
    width: 50%;
    background-size: cover;
}

.section1 img {
    cursor: pointer;
    width: 100%;
    background-size: cover;
}

.section2 {
    display: flex;
    justify-content: center;
}

.section2 img {
    cursor: pointer;
    width: 285px;
    height: 380px;
}

.section3 img {
    cursor: pointer;
    width: 100vw;
    background-size: cover;
}

.section4 {
    display: flex;
    justify-content: center;
}

.section4 img {
    cursor: pointer;
    width: 290px;
    height: 345px;
}

.section5 img {
    cursor: pointer;
    width: 100vw;
    background-size: cover;
}

.section6 {
    display: flex;
    justify-content: center;
}

.section6 img {
    cursor: pointer;
    width: 291px;
    height: 375px;
}

.section7 img {
