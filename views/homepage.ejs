}

/* Mobile adjustments for .foot */
@media (max-width: 500px) {
    .foot {
        font-size: 10px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(2, 1fr);
        gap: 20px;
    }
}
