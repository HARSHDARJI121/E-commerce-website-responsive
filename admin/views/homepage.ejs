<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>E-commerce </title>
    <style>
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        html {
            scroll-behavior: smooth;
        }

        body {
            overflow-x: hidden; /* Prevent horizontal scrolling */
        }

        /* Sticky Nav Styling */
        nav {
            position: sticky;
            background-color: #ffffff;
            top: 0;
            height: 70px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            box-shadow: rgba(0, 0, 0, 0.1) 0px 3px 6px;
            width: 100%;
            z-index: 100;
        }

        /* Left Section (Logo and Links) */
        .left {
            display: flex;
            align-items: center;
        }

        .left img {
            width: 53px;
            height: 36px;
            margin-right: 20px;
        }

        .left ul {
            display: flex;
            list-style: none;
            gap: 20px;
        }

        .left a {
            text-decoration: none;
            text-transform: uppercase;
            font-weight: 500;
            font-size: 14px;
            letter-spacing: 1px;
            color: #333;
            padding: 0 10px;
            transition: color 0.3s ease;
        }

        .left a:hover {
            color: #ff5722;
        }

        /* Right Section (Search and Icons) */
        .right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .right input {
            font-size: 14px;
            height: 36px;
            width: 250px;
            padding: 8px 15px;
            border: 1px solid #ccc;
            border-radius: 4px;
            background: #f9f9f9;
            color: #696e79;
            outline: none;
            transition: width 0.3s ease;
        }

        .right input:focus {
            width: 300px;
            border-color: #ff5722;
        }

        /* Icons Section */
        .icons {
            display: flex;
            gap: 20px;
        }

        .icons a {
            text-decoration: none;
            color: #333;
            font-size: 16px;
            padding: 5px;
            transition: color 0.3s ease;
        }

        .icons a:hover {
            color: #ff5722;
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            .left ul {
                display: none;
            }

            .right input {
                width: 150px;
            }

            .icons a {
                font-size: 14px;
            }
        }

        .container img {
            cursor: pointer;
            width: 96.5vw;
            background-repeat: no-repeat;
            background-size: cover;
            margin-bottom: 25px;
        }

        .section {
            display: flex;
            margin: 3px 2px;
            justify-content: center;
        }

        .section img {
            cursor: pointer;
            width: 48vw;
            background-size: cover;
        }

        .section1 img {
            cursor: pointer;
            width: 100vw;
            background-size: cover;
        }

        .section2 {
            display: flex;
            justify-content: center;
        }

        .section2 img {
            cursor: pointer;
            width: 285px;
            height: 380px;
        }

        .section3 img {
            cursor: pointer;
            width: 100vw;
            background-size: cover;
        }

        .section4 {
            display: flex;
            justify-content: center;
        }

        .section4 img {
            cursor: pointer;
            width: 290px;
            height: 345px;
        }

        .section5 img {
            cursor: pointer;
            width: 100vw;
            background-size: cover;
        }

        .section6 {
            display: flex;
            justify-content: center;
        }

        .section6 img {
            cursor: pointer;
            width: 291px;
            height: 375px;
        }

        .section7 img {
            cursor: pointer;
            width: 100vw;
            background-size: cover;
        }

        .section8 {
            display: flex;
            justify-content: center;
        }

        .section8 img {
            cursor: pointer;
            width: 261px;
            height: 351px;
        }

        footer {
            height: 55px;
            background-color: #f7f7f7;
            padding-top: 28px;
            font-size: 14px;
            color: #696b79;
            font-family: Whitney, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
            letter-spacing: .3px;
        }

        footer a {
            cursor: pointer;
            color: #696b79;
            text-decoration: none;
            font-weight: 500;
        }

        /* Section grid adjustments */
        .box {
            box-sizing: border-box;
            display: flex;
            justify-content: space-between;
            gap: 50px;
            text-align: center;
            flex-wrap: wrap; /* Allow items to wrap */
        }

        .box img {
            height: 300px;
            width: 250px;
            border-radius: 20px;
        }

        .cards {
            width: 250px;
        }

        .cards:hover {
            border-radius: 20px;
            box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
            background-color: antiquewhite;
            color: rgb(0, 0, 0);
        }

        .cards h3:hover {
            color: black;
        }

        .text {
            box-sizing: border-box;
            text-align: center;
            padding: 10px;
            margin-bottom: 10px;
        }

        /* Section 3 flex adjustment */
        .sec-3 {
            display: flex;
            justify-content: center;
            box-sizing: border-box;
        }

        /* Grid responsive layout */
        @media(max-width:400px) {
            .box {
                grid-template-columns: repeat(2, 135px);
                grid-template-rows: repeat(3, 227px);
                height: auto;
            }

            .cards img {
                width: 120px;
                height: 150px;
            }

            .cards h1 {
                font-size: 20px;
                color: green;
            }

            .cards {
                width: 165px;
            }

            .text {
                font-size: xx-small;
                text-align: center;
            }
        }

        /* Mobile responsive for foot section */
        .foot {
            display: flex;
            flex-direction: row;
            justify-content: space-around;
            align-items: center;
            background-color: black;
            color: aliceblue;
            height: 300px;
            width: 100%;
            border: 1px solid;
        }

        .parts {
            text-align: center;
            cursor: pointer;
        }

        .parts h1, h3:hover {
            color: aquamarine;
        }

        /* Mobile adjustments for .foot */
        @media (max-width:500px) {
            .foot {
                font-size: 10px;
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                grid-template-rows: repeat(2, 1fr);
                gap: 20px;
            }
        }
        /* Section 8 - Responsive images */
.section8 {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); /* Adjusts the number of columns based on screen size */
    gap: 20px;
    padding: 20px;
}

.section8 img {
    width: 100%;
    height: auto; /* Ensures images retain their aspect ratio */
    border-radius: 8px; /* Optional: Add rounded corners for a nice effect */
    transition: transform 0.3s ease-in-out; /* Adds a hover effect */
}

.section8 img:hover {
    transform: scale(1.05); /* Slight zoom effect on hover */
}

/* Mobile view: Stack the images vertically for smaller screens */
@media (max-width: 768px) {
    .section8 {
        grid-template-columns: 1fr; /* Stack images vertically on small screens */
    }
}

/* Larger screens: Can increase the grid layout for larger screens */
@media (min-width: 1024px) {
    .section8 {
        grid-template-columns: repeat(5, 1fr); /* Show 5 columns on larger screens */
    }
}
/* Container for the marquee */
.marquee-container {
  width: 100%;
  overflow: hidden;
  position: relative;
}

/* Content to scroll (images) */
.marquee-content {
  display: flex;
  animation: marquee 20s linear infinite;
}

/* Style for the images */
.marquee-content img {
  width: 100%;
  height: auto;
  margin-right: 20px; /* space between images */
}

/* Animation for the scrolling effect */
@keyframes marquee {
  0% {
    transform: translateX(100%);
  }
  100% {
    transform: translateX(-100%);
  }
}

/* Make the images responsive */
@media screen and (max-width: 768px) {
  .marquee-content {
    width: 50%; /* Adjust based on your design */
  }
}

@media screen and (max-width: 480px) {
  .marquee-content img {
    width: 80%; /* Adjust for mobile */
  }
}

    </style>

